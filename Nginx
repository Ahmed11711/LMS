
server {
    listen 443 ssl;
    server_name api.darab.academy;

    # تحديث المسار للشهادة الجديدة
    ssl_certificate /etc/letsencrypt/live/darab.academy-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/darab.academy-0001/privkey.pem;

    # هذه الملفات قد لا تتوفر للمسار الجديد، يفضل استخدام الإعدادات الافتراضية أو التأكد من وجودها
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/LMS/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        # تأكد من أن www.sock هو المستخدم فعلاً أو استبدله بـ php8.4-fpm.sock لو تعطل
        fastcgi_pass unix:/run/php/www.sock;
    }
}

# 2. البلوك الخاص بالفرونت إند (Next.js) - HTTPS
server {
    listen 80 ssl;
    server_name *;

    # تحديث المسار للشهادة الجديدة (Wildcard)
    ssl_certificate /etc/letsencrypt/live/darab.academy-0001/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/darab.academy-0001/privkey.pem;

    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}

# 3. تحويل كل الـ HTTP إلى HTTPS
server {
    listen 80;
    server_name darab.academy *.darab.academy api.darab.academy;
    return 301 https://$host$request_uri;
}
